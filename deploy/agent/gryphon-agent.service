# The Gryphon client agent, as systemd runs it.
#
# Shipped in the .deb and .rpm and installed by install.sh. The agent connects
# out to Gryphon; nothing listens, so the machine needs no open port. Enable
# and start it with `sudo gryphon-agent enrol`, which asks for the token from
# the host's page in Gryphon.
#
# Settings go in /etc/gryphon/agent.env (GWC_* variables; see the readme). The
# token is /etc/gryphon/agent_key, readable by root only. systemd opens it and
# hands it to the agent on standard input, which the agent reads once and
# closes: the agent's user has no path to the file, so neither do the scripts
# it runs as that user.
[Unit]
Description=Gryphon client agent
Documentation=https://github.com/gocodedotca/gryphon-agent#readme
After=network-online.target
Wants=network-online.target
# Not enrolled yet: nothing to connect with, so nothing to start.
ConditionPathExists=/etc/gryphon/agent_key

[Service]
ExecStart=/usr/bin/gryphon-agent
EnvironmentFile=-/etc/gryphon/agent.env
StandardInput=file:/etc/gryphon/agent_key
StandardOutput=journal
StandardError=journal
Environment=GWC_KEY_FILE=-
Restart=on-failure
RestartSec=5

# A user made for the service and gone when it stops: nothing on the machine
# is owned by it, so nothing it could change survives it.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No capabilities at all. For ICMP in the ping check, replace this line with
# the two below it; without them the check probes TCP 443, 80 and 22 instead.
CapabilityBoundingSet=
#CapabilityBoundingSet=CAP_NET_RAW
#AmbientCapabilities=CAP_NET_RAW

# Container and Swarm checks. Recommended: a docker-socket-proxy that allows
# only reads of containers, services and tasks, reached over TCP -- set
#   GWC_DOCKER_SOCKET=tcp://127.0.0.1:2375
# in agent.env. The alternative below opens the Engine's own socket, which is
# root on this machine to whoever holds it.
#SupplementaryGroups=docker

# File freshness checks (GWC_WATCH_DIRS in agent.env) list the folders named
# there; they never open a file. The service's user is made fresh and belongs
# to no group, so a folder it may not list -- /var/backups owned by root:backup
# with mode 0750, say -- needs that group added, in a drop-in
# (systemctl edit gryphon-agent) alongside docker if both are wanted:
#SupplementaryGroups=backup

[Install]
WantedBy=multi-user.target
